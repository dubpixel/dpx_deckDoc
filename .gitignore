### DPX_DECKDOC GIT IGNORE v0.1.0
# Node
node_modules/
npm-debug.log*

# Generated output (images, manifest, generated site) — any output* dir,
# including ad-hoc test dirs like output_local/
output/
output*/

# Captured device data (scrape output — real button images/config, not source)
devices/

# Demo generator's intermediate build output — the committed copy lives at /demo/
demo-src/device/site/

# Editor workspace files (not shared team config)
*.code-workspace

# Local env / secrets
.env
.env.local

# OS / editor
.DS_Store
*~
\#*
.\#*
.vscode/*
!.vscode/settings.json

# Playwright
test-results/
playwright-report/
